# Google AI Studio API Key (Free Tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Notion Integration Token & Database ID (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Runtime Mode: "false" for local visible browser, "true" for Docker / GitHub Actions headless mode
HEADLESS=false

# Local SQLite database path
DB_PATH=data/jobs.db

