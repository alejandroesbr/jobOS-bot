# Local SQLite database path
DB_PATH=data/jobs.db

# External Obsidian Vault path (must be outside this repository)
OBSIDIAN_VAULT_PATH=/home/tu_usuario/Documents/Obsidian Vault
OBSIDIAN_VAULT_SUBFOLDER=jobOS

# Runtime Mode: "false" for local visible browser, "true" for Docker / Headless mode
HEADLESS=false

# Optional Secondary Target: Notion Integration Token & Database ID (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
